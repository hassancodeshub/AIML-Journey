from sklearn.svm import SVR
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score
from sklearn import datasets


df = datasets.load_diabetes(as_frame = True).frame


df.head()


X = df.drop("target",axis = 1)
y = df["target"]


x_train,x_test,y_train,y_test = train_test_split(
    X, y, random_state = 42, test_size = 0.3
)


scaler = StandardScaler()

y_train_scaled =  scaler.fit_transform(y_train.values.reshape(-1,1)).ravel()
y_test_scaled =  scaler.transform(y_test.values.reshape(-1,1)).ravel()


model = SVR()

model.fit(x_train,y_train_scaled)


y_test_pred_scaled = model.predict(x_test)
y_train_pred_scaled = model.predict(x_train)


print(f"y train r2 : {r2_score(y_train_scaled,y_train_pred_scaled)}")
print(f"y test r2 : {r2_score(y_test_scaled,y_test_pred_scaled)}")


# Linear SVR :

from sklearn.svm import LinearSVR

model = LinearSVR(C = 10, epsilon = 0.1, max_iter = 5000)

model.fit(x_train, y_train_scaled)

y_test_pred_scaled = model.predict(x_test)
y_train_pred_scaled = model.predict(x_train)

print("train r2: ", r2_score(y_train_scaled, y_train_pred_scaled))
print("test r2: ", r2_score(y_test_scaled, y_test_pred_scaled))
